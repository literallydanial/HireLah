# =========================================================================
# HIRESENSE APACHE SECURITY & PROTECTION (.htaccess)
# Designed for Apache 2.2 / 2.4 (Ubuntu / XAMPP)
# =========================================================================

# Block direct web access to configuration, secrets, dependencies, backups & SQL/zip artifacts
<FilesMatch "^(config\.json|composer\.(json|lock|phar|setup\.php)|schema.*\.sql|\.htaccess|\.git.*|.*\.log|.*\.sql|.*\.zip|.*\.bak|.*\.env.*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Disable Directory Browsing
Options -Indexes

# Set UTF-8 Default Charset
AddDefaultCharset UTF-8

# Allow larger uploads and avoid 413 Request Entity Too Large (100MB)
LimitRequestBody 104857600

<IfModule mod_php.c>
    php_value upload_max_filesize 64M
    php_value post_max_size 64M
    php_value memory_limit 256M
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 64M
    php_value post_max_size 64M
    php_value memory_limit 256M
</IfModule>
<IfModule mod_php8.c>
    php_value upload_max_filesize 64M
    php_value post_max_size 64M
    php_value memory_limit 256M
</IfModule>
